{
  "manifest_version": 3,
  "name": "Mermaid Preview",
  "version": "1.1.0",
  "description": "Détecte les snippets Mermaid (Jira, Confluence, GitLab…) et affiche un aperçu du diagramme au survol.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/detect.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["preview/preview.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
